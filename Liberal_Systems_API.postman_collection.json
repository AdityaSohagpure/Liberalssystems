					"name": "Admin Sign Up",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.token) {",
									"    pm.collectionVariables.set(\"admin_token\", jsonData.token);",
									"    console.log(\"Saved admin_token to collection variables!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"newadmin\",\n  \"password\": \"LiberalAdmin2026!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/signup",
